<atlassian-plugin key="io.github.timux.confluence.pdf" name="Universal PDF Exporter" plugins-version="2">
  <plugin-info>
    <description>In-process PDF export with a shared neutral template.</description>
    <version>${project.version}</version>
    <vendor name="TimUx" url="https://github.com/TimUx/confluence-pdf-exporter"/>
  </plugin-info>
  <component-import key="contentService" interface="com.atlassian.confluence.api.service.content.ContentService"/>
  <component-import key="childContentService" interface="com.atlassian.confluence.api.service.content.ChildContentService"/>
  <component-import key="attachmentService" interface="com.atlassian.confluence.api.service.content.AttachmentService"/>
  <component-import key="contentBodyConversionService" interface="com.atlassian.confluence.api.service.content.ContentBodyConversionService"/>
  <component-import key="permissionManager" interface="com.atlassian.confluence.security.PermissionManager"/>
  <component-import key="attachmentManager" interface="com.atlassian.confluence.pages.AttachmentManager"/>
  <component-import key="pluginSettingsFactory" interface="com.atlassian.sal.api.pluginsettings.PluginSettingsFactory"/>
  <component-import key="transactionTemplate" interface="com.atlassian.sal.api.transaction.TransactionTemplate"/>
  <component-import key="clusterLockService" interface="com.atlassian.beehive.ClusterLockService"/>
  <servlet key="pdf-servlet" name="Universal PDF Export" class="io.github.timux.pdf.confluence.PdfServlet">
    <url-pattern>/universal-pdf/*</url-pattern>
  </servlet>
  <web-item key="page-export" name="Universal PDF export" section="system.content.action/secondary" weight="60">
    <label>Als PDF exportieren (Universal)</label>
    <link linkId="universal-pdf-export">/plugins/servlet/universal-pdf/export?pageId=$page.id</link>
  </web-item>
  <web-item key="pdf-administration" name="PDF export settings" section="system.admin/configuration" weight="150">
    <label>Universal PDF Exporter</label>
    <link linkId="universal-pdf-admin">/plugins/servlet/universal-pdf/admin</link>
  </web-item>
</atlassian-plugin>
